LOG_LEVEL=DEBUG

# Mode
RUN_MODE=webhook
WEBHOOK_SECRET=change-me-please #or leave empty for no secret 

# qBittorrent
QBIT_URL=https://qbittorrent.example.org
QBIT_USERNAME=admin
QBIT_PASSWORD=supersecret
QBIT_VERIFY_TLS=true

# Uploading-tag feature
UPLOADING_TAG=uploading # Tag applied in the Arrs when an upload is in progress
UPLOAD_QBIT_CATEGORY=tracker_own_uploads # Category to set in qBittorrent for uploads

# If you have a SECOND qBittorrent just for uploads, set these.
# If not set, the tool will fall back to the primary QBIT_* config.
QBIT_UPLOAD_URL=
QBIT_UPLOAD_USERNAME=
QBIT_UPLOAD_PASSWORD=
QBIT_UPLOAD_VERIFY_TLS=true

# Separate state file for uploading sync
UPLOADING_STATE_FILE=./data/uploading_state.json

# Remove tag when torrent leaves upload category
UPLOADING_SYNC_REMOVE_TAG=true

# Cache “unmatched” torrents to avoid repeated /parse calls
UPLOADING_UNMATCHED_TTL_HOURS=24

# Custom Quality Profile to set when tagging uploading torrents, MUST EXIST in Sonarr/Radarr
UPLOADING_CQP_NAME=No Upgrades

# Enforce Quality Profile when tagging uploading torrents and restore previous profile when tag "uploading" is removed
UPLOADING_CQP_ENFORCE=true
UPLOADING_CQP_RESTORE=true

# Interval in minutes to verify the CQP of "uploading" tagged torrents in Sonarr/Radarr
UPLOADING_CQP_VERIFY_INTERVAL_MINUTES=60


# Sonarr / Radarr
SONARR_URL=https://sonarr.example.org
SONARR_API_KEY=xxxx
RADARR_URL=https://radarr.example.org
RADARR_API_KEY=xxxx

# Tagging
PUBLIC_TAG=public
PRIVATE_TRACKERS_FILE=./private_trackers.yml
SOURCE_TAG_PREFIXES=pt-,public
STATE_FILE=./data/state.json

WEBHOOK_BIND=0.0.0.0
WEBHOOK_PORT=8787
